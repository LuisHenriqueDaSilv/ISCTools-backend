POSTGRES_USER=isctools
POSTGRES_PASSWORD=isctools
POSTGRES_DB=isctools

DATABASE_URL=postgresql://isctools:isctools@db:5432/isctools

# LangSmith — observabilidade (opcional em dev, recomendado em prod)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=isctools

# CORS — lista de origens permitidas, separadas por vírgula (sem barra final)
# Ex.: CORS_ALLOWED_ORIGINS=https://isctools.exemplo.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
